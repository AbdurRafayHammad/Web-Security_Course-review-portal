<!DOCTYPE html>
<html>
<head><title>Search</title></head>
<body>
  <h1>Search Courses</h1>
  <form method="GET" action="/search">
    <input name="q" value="<%= q %>">
    <button>Search</button>
  </form>

  <!-- FIX: <%= %> auto-escapes HTML -> Reflected XSS payload shows as plain text -->
  <h2>Results for: <%= q %></h2>

  <% if (error) { %><p style="color:red"><%= error %></p><% } %>
  <ul>
    <% rows.forEach(r => { %>
      <li><%= r.course %> - <%= r.author %></li>
    <% }) %>
  </ul>
</body>
</html>
