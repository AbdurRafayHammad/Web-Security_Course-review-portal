<!DOCTYPE html>
<html>
<head><title>Profile</title></head>
<body>
  <h1>Profile: <%= username %></h1>

  <div id="bio"></div>
  <script>
    // FIX: textContent instead of innerHTML -> location.hash can never inject HTML/JS
    document.getElementById('bio').textContent = decodeURIComponent(location.hash.slice(1));
  </script>

  <h3>Update Email (CSRF protected)</h3>
  <form method="POST" action="/update-email">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input name="email" placeholder="new email">
    <button>Update</button>
  </form>
</body>
</html>
