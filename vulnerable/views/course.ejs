<!DOCTYPE html>
<html>
<head><title>Course</title></head>
<body>
  <h1>Course: <%= course %></h1>
  <h3>Reviews</h3>
  <ul>
    <% reviews.forEach(r => { %>
      <!-- VULNERABLE: comment printed unescaped -> Stored XSS -->
      <li><b><%= r.author %>:</b> <%- r.comment %></li>
    <% }) %>
  </ul>

  <form method="POST" action="/course/<%= course %>/review">
    <textarea name="comment" placeholder="Write a review"></textarea><br>
    <button>Submit Review</button>
  </form>
  <p style="color:gray">Stored XSS demo: submit a review with <code>&lt;script&gt;alert('stored')&lt;/script&gt;</code></p>
</body>
</html>
